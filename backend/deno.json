{
  "tasks": {
    "test": {
      "description": "Run unit tests",
      "command": "deno test --allow-read --allow-env"
    },
    "test:integration": {
      "description": "Run integration tests",
      "command": "DENO_INTEGRATION_TEST=1 deno test --allow-run --allow-write --allow-read --allow-env"
    },
    "cover": {
      "description": "Generate test coverage report",
      "command": "DENO_INTEGRATION_TEST=1 deno test --coverage --parallel --allow-run --allow-write --allow-read --allow-env"
    },
    "start": {
      "description": "Start the server",
      "command": "deno run --allow-net --allow-env --allow-write --allow-read --allow-run --allow-import --allow-sys server.ts"
    },
    "start:watch": {
      "description": "Start the server in watch/development mode",
      "command": "deno run --allow-net --allow-env --allow-write --allow-read --allow-run --allow-import --allow-sys --watch server.ts"
    }
  },
  "compilerOptions": {
    "lib": ["ES2022", "deno.ns", "dom"]
  },
  "imports": {
    "@bgub/eta": "jsr:@bgub/eta@^4.6.0",
    "@db/mongo": "jsr:@db/mongo@^0.34.0",
    "@hono/hono": "jsr:@hono/hono@^4.12.27",
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@^1.4.0",
    "@mirror/xlsx": "jsr:@mirror/xlsx@^0.20.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.30",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.22",
    "@std/yaml": "jsr:@std/yaml@^1.1.1",
    "ldapts": "npm:ldapts@^8.1.8",
    "nodemailer": "npm:nodemailer@^8.0.1"
  }
}
